# SafeRoute AI Backend configuration

APP_NAME=SafeRoute AI
APP_VERSION=1.0.0
DEBUG=true
API_V1_STR=/api/v1

BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL + PostGIS
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/saferoute
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/saferoute

# Redis
REDIS_URL=redis://localhost:6379/0

# Simulation (runs when no live GPS/camera feeds are configured)
SIMULATION_ENABLED=true
SIMULATION_VEHICLE_COUNT=60
SIMULATION_TICK_INTERVAL_MS=1000

# Cesium 3D Tiles (optional). Set Cesium Ion access token and a 3D Tiles URL
# for real-world building mesh (e.g. Cesium OSM Buildings).
CESIUM_ION_ACCESS_TOKEN=
CESIUM_3D_TILES_URL=

# OSRM routing (public demo instance; self-host for production)
OSRM_BASE_URL=http://router.project-osrm.org
